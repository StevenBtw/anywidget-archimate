{
  "name": "anywidget-archimate",
  "private": true,
  "type": "module",
  "description": "Front end of the anywidget-archimate widget, in TypeScript (bundled with esbuild; type-checked with tsc)",
  "scripts": {
    "build": "node scripts/build-esm.mjs",
    "check": "node scripts/build-esm.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "uv run pytest tests/test_ui.py -k test_javascript"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
